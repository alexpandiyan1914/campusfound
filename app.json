{
  "expo": {
    "name": "CampusFound",
    "slug": "campusfound-frontend",
    "version": "0.9.0",
    "orientation": "portrait",
    "icon": "./assets/campusfound-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.alexpandiyan.campusfound",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/campusfound-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/campusfound-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#0B5CC4",
          "defaultChannel": "campusfound"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "09a2eba9-3a8d-4a0d-aa91-f644f9a67112"
      }
    },
    "owner": "alexpandiyan1914"
  }
}
